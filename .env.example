# ---- URLs ----
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000          # comma-separate multiple origins for CORS

# ---- Database: Supabase transaction pooler (port 6543). URL-encode special chars in the password (@ -> %40)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ---- Auth ----
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d

# ---- Scheduler / queue ----
CRON_SECRET=change-me-too
QUEUE_MODE=local                            # "qstash" in production
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---- Research + LLM ----
TAVILY_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite             # with billing enabled: gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30

# ---- Gnani TTS ----
GNANI_API_KEY=
GNANI_MODEL=timbre-v3.0
GNANI_VOICE=Shivani
GNANI_LANGUAGE=en-IN

# ---- Storage (Supabase) ----
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=                  # Project Settings -> API Keys: secret key (sb_secret_...) or legacy service_role
STORAGE_BUCKET=artifacts

# ---- Email ----
# smtp (default): Gmail + App Password (https://myaccount.google.com/apppasswords, needs 2-Step Verification).
#   Free, no domain, reaches any address (~500/day). SMTP_USERNAME must be the Gmail that created the App Password.
# resend: needs a verified domain to email anyone except the Resend account owner.
EMAIL_PROVIDER=smtp
EMAIL_FROM=DailyCast
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=abcd efgh ijkl mnop
RESEND_API_KEY=

# ---- Local testing only: enables POST /api/auth/signin/dev (get a JWT without Google). Keep false in production.
ALLOW_DEV_LOGIN=false

# ---- Session cookie ----
SESSION_COOKIE_SECURE=true                  # false for local http://localhost
SESSION_COOKIE_SAMESITE=lax                 # lax when the Next.js app proxies /api to this backend
